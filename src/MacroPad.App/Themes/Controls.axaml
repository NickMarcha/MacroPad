<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared looks, by class. Colours and radii come from Tokens.axaml only. -->

    <!-- Text -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>
    <Style Selector="TextBlock.note">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>

    <!-- A pad's name, editable in place: looks like a title until you point at it -->
    <Style Selector="TextBox.title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="-7,0,0,0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- An unnamed pad shows "Pad 2" as a placeholder; it should read as the title, not as greyed out. -->
    <Style Selector="TextBox.title /template/ TextBlock#PART_Placeholder">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBox.title /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.title:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>
    <Style Selector="TextBox.title:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- Containers -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
    </Style>
    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.statusbar">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,6" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.BorderStrong}" />
    </Style>
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="{DynamicResource Size.Icon}" />
        <Setter Property="Height" Value="{DynamicResource Size.Icon}" />
    </Style>
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- Sidebar navigation: a list of pads and the Settings button below it -->
    <Style Selector="ListBox.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
    </Style>
    <Style Selector="Button.nav">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
    </Style>

    <!-- Layer tabs: text with an underline under the selected one -->
    <Style Selector="ListBox.tabs">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem">
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="Margin" Value="0,0,20,0" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <!-- Keys / Lights: two words with an underline under the chosen one, like the layer tabs -->
    <Style Selector="RadioButton.view">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="line" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="4,6" Background="Transparent">
                    <ContentPresenter Name="text" Content="{TemplateBinding Content}" Foreground="{DynamicResource Brush.TextMuted}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.view:pointerover /template/ ContentPresenter#text">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>
    <Style Selector="RadioButton.view:checked /template/ Border#line">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="RadioButton.view:checked /template/ ContentPresenter#text">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <!-- A colour swatch -->
    <Style Selector="Button.swatch">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    </Style>

    <!-- The drawn pad: keycaps and knobs -->
    <Style Selector="Button.keycap">
        <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.keycap:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    </Style>
    <Style Selector="Button.keycap.selected /template/ ContentPresenter, Button.keycap.lit /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
    </Style>
    <Style Selector="Button.knob">
        <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.turn">
        <Setter Property="Padding" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.turn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.turn.selected /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
    </Style>
    <!-- Where a dragged key would land -->
    <Style Selector="Button.keycap.drop /template/ ContentPresenter, Button.turn.drop /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
    </Style>
    <Style Selector="ListBox.tabs TextBlock.drop">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <!-- A thin line between groups of toolbar buttons -->
    <Style Selector="Border.divider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,6" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
    </Style>
    <Style Selector="TextBlock.keynum">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>

    <!-- Click, then press keys -->
    <Style Selector="Border.recorder">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.recorder:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- A spot on the pop-up position screen: an outline, filled where the pop-up goes -->
    <Style Selector="RadioButton.spot">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="mark" Width="52" Height="24" CornerRadius="3" BorderThickness="1"
                        BorderBrush="{DynamicResource Brush.Border}" Background="Transparent" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.spot:pointerover /template/ Border#mark">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    </Style>
    <Style Selector="RadioButton.spot:checked /template/ Border#mark">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style Selector="Expander.connection">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Expander.connection /template/ ToggleButton#ExpanderHeader">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
</Styles>
