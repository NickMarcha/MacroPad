<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MacroPad.App.ViewModels"
        xmlns:local="using:MacroPad.App"
        xmlns:core="using:MacroPad.Core"
        xmlns:ha="using:MacroPad.Core.HomeAssistant"
        x:Class="MacroPad.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/macropad.ico"
        Width="1040" Height="720" MinWidth="820" MinHeight="560"
        Title="MacroPad">

    <Window.Styles>
        <Style Selector="Button.slot">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.slot.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Border.recorder">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.recorder:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <DataTemplate x:Key="SlotButton" x:DataType="vm:SlotViewModel">
            <Button Classes="slot" Classes.selected="{Binding IsSelected}"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectSlotCommand}"
                    CommandParameter="{Binding}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Label}" Classes="heading" />
                        <TextBlock Text="{Binding Summary}" FontSize="15" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="Orange" VerticalAlignment="Top"
                             IsVisible="{Binding IsDirty}" ToolTip.Tip="Not written to the pad yet" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="16,12" Background="#18FFFFFF">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="MacroPad" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersionText}" Opacity="0.6" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                    </StackPanel>
                    <TextBlock Text="{Binding DeviceStatus}" Opacity="0.8" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Connect" Command="{Binding ConnectCommand}" />
                    <Button Content="Read from pad" Command="{Binding ReadCommand}" />
                    <Button Content="Write to pad" Classes="accent" Command="{Binding WriteCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status line: what's happening on the left, how the app is installed and updates on the right -->
        <Border DockPanel.Dock="Bottom" Padding="16,6" Background="#10FFFFFF">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding InstallText}" Opacity="0.6" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UpdateText}" Foreground="Gold" VerticalAlignment="Center"
                               IsVisible="{Binding UpdateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Content="Update now" Classes="accent" Padding="10,2" Command="{Binding UpdateCommand}" IsVisible="{Binding CanUpdate}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left: layers, pad and lights -->
        <DockPanel DockPanel.Dock="Left" Width="360">
            <ListBox DockPanel.Dock="Top" Margin="16,16,16,0" IsEnabled="{Binding IsConnected}" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LayerViewModel">
                        <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer>
                <StackPanel Margin="16" Spacing="16">
                    <StackPanel Spacing="16" IsEnabled="{Binding IsConnected}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="KEYS" Classes="heading" />
                            <ItemsControl ItemsSource="{Binding SelectedLayer.Buttons}" ItemTemplate="{StaticResource SlotButton}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="KNOB" Classes="heading" />
                            <ItemsControl ItemsSource="{Binding SelectedLayer.Knobs}" ItemTemplate="{StaticResource SlotButton}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="LIGHTS (THIS LAYER)" Classes="heading" />
                            <Grid ColumnDefinitions="*,8,*">
                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:MainViewModel.LedModes}" SelectedItem="{Binding LedMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static local:Converters.Words}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:MainViewModel.LedColors}" SelectedItem="{Binding LedColor}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static local:Converters.Words}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Button Content="Apply lights" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ApplyLedCommand}" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                                       Text="Lights are written straight away. The pad can't report its current light setting, so this doesn't show what's on it now." />
                        </StackPanel>
                    </StackPanel>

                    <!-- Home Assistant and running in the background: usable without the pad plugged in -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="HOME ASSISTANT" Classes="heading" />
                        <TextBox Text="{Binding HaUrl}" PlaceholderText="https://homeassistant.local:8123" />
                        <TextBox Text="{Binding HaToken}" PasswordChar="•" PlaceholderText="Long-lived access token (kept once saved)" />
                        <Button Content="Connect" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ConnectHaCommand}" />
                        <TextBlock Text="{Binding HaStatus}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                                   Text="Make a token in Home Assistant under your profile, Security, Long-lived access tokens." />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="IN THE BACKGROUND" Classes="heading" />
                        <CheckBox Content="Keep running in the tray when closed" IsChecked="{Binding KeepRunningInTray}" />
                        <CheckBox Content="Start at login (in the tray)" IsChecked="{Binding StartAtLogin}" IsEnabled="{Binding CanStartAtLogin}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                                   Text="Home Assistant actions only work while MacroPad is running. Everything else is stored on the pad." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Right: editor for the selected slot -->
        <ScrollViewer>
            <ContentControl Margin="24,16" Content="{Binding SelectedSlot}" IsEnabled="{Binding IsConnected}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:SlotViewModel">
                        <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="ACTION" Classes="heading" />
                                <ComboBox ItemsSource="{x:Static vm:SlotViewModel.Kinds}" SelectedItem="{Binding Kind}" MinWidth="200">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static local:Converters.Words}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Keyboard -->
                            <StackPanel Spacing="12" IsVisible="{Binding IsKeyboard}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="RECORD" Classes="heading" />
                                    <Border Classes="recorder" Focusable="True" KeyDown="Recorder_KeyDown" PointerPressed="Recorder_PointerPressed">
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="Click here, then press a key or combination (e.g. Ctrl+Shift+S). Each press adds a step." />
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="STEPS" Classes="heading" />
                                    <ItemsControl ItemsSource="{Binding Chords}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:KeyChord">
                                                <Border Background="#28FFFFFF" CornerRadius="6" Padding="10,4,4,4" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Converter={x:Static local:Converters.Chord}}" VerticalAlignment="Center" />
                                                        <Button Content="✕" Padding="6,0" Background="Transparent"
                                                                Command="{Binding $parent[ItemsControl].((vm:SlotViewModel)DataContext).RemoveChordCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Clear steps" Command="{Binding ClearChordsCommand}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="ADD A KEY BY NAME (F13–F24, keys your OS grabs)" Classes="heading" />
                                    <WrapPanel>
                                        <CheckBox Content="Ctrl" IsChecked="{Binding PickCtrl}" Margin="0,0,8,0" />
                                        <CheckBox Content="Shift" IsChecked="{Binding PickShift}" Margin="0,0,8,0" />
                                        <CheckBox Content="Alt" IsChecked="{Binding PickAlt}" Margin="0,0,8,0" />
                                        <CheckBox Content="Win/Super" IsChecked="{Binding PickWin}" Margin="0,0,8,0" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox ItemsSource="{x:Static vm:SlotViewModel.KeyChoices}" SelectedItem="{Binding PickedKey}"
                                                  MinWidth="160" MaxDropDownHeight="320" PlaceholderText="Key" />
                                        <Button Content="Add step" Command="{Binding AddPickedKeyCommand}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="DELAY BETWEEN STEPS (MS)" Classes="heading" />
                                    <NumericUpDown Value="{Binding DelayMs}" Minimum="0" Maximum="6000" Increment="10" FormatString="0" Width="160" HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Media -->
                            <StackPanel Spacing="6" IsVisible="{Binding IsMedia}">
                                <TextBlock Text="MEDIA KEY" Classes="heading" />
                                <ComboBox ItemsSource="{x:Static vm:SlotViewModel.MediaChoices}" SelectedItem="{Binding Media}" MinWidth="220" PlaceholderText="Choose…" />
                            </StackPanel>

                            <!-- Mouse -->
                            <StackPanel Spacing="12" IsVisible="{Binding IsMouse}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="BUTTONS" Classes="heading" />
                                    <WrapPanel>
                                        <CheckBox Content="Left" IsChecked="{Binding MouseLeft}" Margin="0,0,8,0" />
                                        <CheckBox Content="Right" IsChecked="{Binding MouseRight}" Margin="0,0,8,0" />
                                        <CheckBox Content="Middle" IsChecked="{Binding MouseMiddle}" Margin="0,0,8,0" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="HOLD" Classes="heading" />
                                    <WrapPanel>
                                        <CheckBox Content="Ctrl" IsChecked="{Binding MouseCtrl}" Margin="0,0,8,0" />
                                        <CheckBox Content="Shift" IsChecked="{Binding MouseShift}" Margin="0,0,8,0" />
                                        <CheckBox Content="Alt" IsChecked="{Binding MouseAlt}" Margin="0,0,8,0" />
                                        <CheckBox Content="Win/Super" IsChecked="{Binding MouseWin}" Margin="0,0,8,0" />
                                    </WrapPanel>
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,12,Auto,12,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Text="WHEEL (+ UP)" Classes="heading" />
                                    <TextBlock Grid.Column="2" Text="MOVE X" Classes="heading" />
                                    <TextBlock Grid.Column="4" Text="MOVE Y" Classes="heading" />
                                    <NumericUpDown Grid.Row="1" Value="{Binding Wheel}" Minimum="-127" Maximum="127" FormatString="0" Width="130" />
                                    <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding MoveX}" Minimum="-127" Maximum="127" FormatString="0" Width="130" />
                                    <NumericUpDown Grid.Row="1" Grid.Column="4" Value="{Binding MoveY}" Minimum="-127" Maximum="127" FormatString="0" Width="130" />
                                </Grid>
                            </StackPanel>

                            <!-- Home Assistant -->
                            <StackPanel Spacing="12" IsVisible="{Binding IsHomeAssistant}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="DO" Classes="heading" />
                                    <ComboBox ItemsSource="{x:Static vm:SlotViewModel.HaCommands}" SelectedItem="{Binding HaCommand}" MinWidth="200">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static local:Converters.Words}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="ON" Classes="heading" />
                                    <ComboBox ItemsSource="{x:Static vm:SlotViewModel.HaTargets}" SelectedItem="{Binding HaTarget}" MinWidth="260"
                                              MaxDropDownHeight="360" PlaceholderText="Connect to Home Assistant first, then pick an area or light" />
                                </StackPanel>
                                <StackPanel Spacing="6" IsVisible="{Binding IsStepped}">
                                    <TextBlock Text="STEP (%)" Classes="heading" />
                                    <NumericUpDown Value="{Binding HaStep}" Minimum="1" Maximum="100" Increment="5" FormatString="0" Width="130" HorizontalAlignment="Left" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                                           Text="The pad sends a code your computer ignores, and MacroPad turns it into the Home Assistant action. Toggle on an area works like a wall switch: if any light is on, all go off. Brighter and Dimmer suit the knob's turns." />
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                                       Text="Changes are marked with an orange dot until you press Write to pad. Settings live on the pad itself, so they work on any computer without this app." />
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </ScrollViewer>
    </DockPanel>
</Window>
