<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MacroPad.App.ViewModels"
        xmlns:views="using:MacroPad.App.Views"
        x:Class="MacroPad.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/macropad.ico"
        Width="1240" Height="780" MinWidth="1000" MinHeight="600"
        Background="{DynamicResource Brush.Background}"
        Title="MacroPad">

    <DockPanel>
        <!-- Status line: what's happening on the left, how the app is installed and updates on the right -->
        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding InstallText}" Classes="muted" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UpdateText}" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"
                               IsVisible="{Binding UpdateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Content="Update now" Classes="accent" Padding="10,2" Command="{Binding UpdateCommand}" IsVisible="{Binding CanUpdate}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar: the active profile (it covers every pad), the pads, and the app's settings -->
        <Border DockPanel.Dock="Left" Width="{DynamicResource Size.Sidebar}" Classes="sidebar">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="MacroPad" Classes="title" />
                        <TextBlock Text="{Binding VersionText}" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Profile" Classes="label" />
                        <Grid ColumnDefinitions="*,4,Auto">
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:SlotViewModel.ProfileNames}" SelectedItem="{Binding ActiveProfileName}"
                                      ToolTip.Tip="The active profile, and the one you edit" />
                            <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Manage profiles" AutomationProperties.Name="Manage profiles">
                                <PathIcon Data="{StaticResource Icon.PencilOutline}" />
                                <Button.Flyout>
                                    <Flyout Placement="RightEdgeAlignedTop">
                                        <StackPanel Width="300" Spacing="10">
                                            <TextBlock Text="Profiles" Classes="label" />
                                            <Grid ColumnDefinitions="*,6,Auto">
                                                <TextBox Text="{Binding ProfileNameDraft}" PlaceholderText="Profile name" />
                                                <Button Grid.Column="2" Content="Rename" Command="{Binding RenameProfileCommand}" />
                                            </Grid>
                                            <WrapPanel>
                                                <Button Command="{Binding AddProfileCommand}" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="{StaticResource Icon.Plus}" />
                                                        <TextBlock Text="New" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding MakeDefaultCommand}" IsEnabled="{Binding !IsEditingDefault}" Margin="0,0,6,6"
                                                        ToolTip.Tip="Other profiles fall back to the default for keys they don't set">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="{StaticResource Icon.Check}" />
                                                        <TextBlock Text="Make default" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding DeleteProfileCommand}" IsEnabled="{Binding !IsEditingDefault}" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="{StaticResource Icon.TrashCanOutline}" />
                                                        <TextBlock Text="Delete" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="ImportProfiles_Click" ToolTip.Tip="Add profiles from a file" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="{StaticResource Icon.Import}" />
                                                        <TextBlock Text="Import…" />
                                                    </StackPanel>
                                                </Button>
                                                <Button ToolTip.Tip="Save profiles to a file" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="{StaticResource Icon.Export}" />
                                                        <TextBlock Text="Export" />
                                                    </StackPanel>
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="This profile…" Click="ExportProfile_Click" />
                                                            <MenuItem Header="All profiles…" Click="ExportAllProfiles_Click" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding DefaultNote}" Classes="note" />
                                            <TextBlock Classes="note"
                                                       Text="Profiles change what MacroPad action keys do, on every pad; whatever a profile doesn't set comes from the default profile. Keyboard, media and mouse keys are stored on the pad and are the same in every profile." />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="8">
                    <Button Classes="nav" Classes.selected="{Binding IsSettingsOpen}" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Icon.CogOutline}" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </Border>

                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,4,10,4">
                        <TextBlock Text="Pads" Classes="label" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding ConnectCommand}" ToolTip.Tip="Look for pads again" AutomationProperties.Name="Look for pads again">
                            <PathIcon Data="{StaticResource Icon.Refresh}" />
                        </Button>
                    </Grid>
                    <ListBox Classes="nav" ItemsSource="{Binding PadChoices}" SelectedItem="{Binding SelectedPad}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PadChoice">
                                <Grid ColumnDefinitions="Auto,10,*">
                                    <PathIcon Data="{StaticResource Icon.Dialpad}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource Icon.Usb}" Width="12" Height="12" Foreground="{DynamicResource Brush.TextMuted}"
                                                      IsVisible="{Binding IsConnected}" />
                                            <PathIcon Data="{StaticResource Icon.Bluetooth}" Width="12" Height="12" Foreground="{DynamicResource Brush.TextMuted}"
                                                      IsVisible="{Binding OnBluetooth}" />
                                            <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Border>

        <Panel>
            <views:PadPage IsVisible="{Binding !IsSettingsOpen}" />
            <views:SettingsPage IsVisible="{Binding IsSettingsOpen}" />
        </Panel>
    </DockPanel>
</Window>
